# Copy to backend/.env for local development. Never commit .env.
# Local defaults already match AUTH_MODE=dev + SQLite + filesystem storage,
# so a copy is only needed when you want to override something.

ENVIRONMENT=development
AUTH_MODE=dev
DATABASE_URL=sqlite:///./nailtrack.db
AUTO_CREATE_TABLES=true

STORAGE_BACKEND=auto
LOCAL_STORAGE_PATH=data/uploads
AZURE_STORAGE_CONN_STRING=
AZURE_STORAGE_CONTAINER=nailtrack-private
SAS_URL_TTL_SECONDS=300

# Quality thresholds (server re-check and the values the client HUD should use).
BLUR_LAPLACIAN_MIN=110.0
GLARE_RATIO_MAX=0.08
TILT_DEG_MAX=10.0
RIDGE_SCORE_INSIGHT_THRESHOLD=0.35
GABOR_ENERGY_FLOOR=0.0001
DEFAULT_VELOCITY_MM_DAY=0.11
POPULATION_VELOCITY_MM_DAY=0.115

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
MAX_IMAGE_EDGE_PX=1600
HAND_MODEL_PATH=models/hand_landmarker.task

# --- Microsoft Entra External ID (required when AUTH_MODE=entra) ---
# Leave blank in dev. Production refuses to boot without these.
# Issuer and JWKS default from the subdomain + tenant id (External ID / CIAM):
#   https://{ENTRA_TENANT_SUBDOMAIN}.ciamlogin.com/{ENTRA_TENANT_ID}/v2.0
# Override ENTRA_ISSUER and ENTRA_JWKS_URL from the tenant's
# /.well-known/openid-configuration if your host form differs.
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CLIENT_ID=
# Comma-separated if the API should accept both the client id and api://<client-id>.
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
# Optional. When set, the access token must carry this value in scp or roles.
ENTRA_REQUIRED_SCOPE=
# Optional comma-separated SPA client ids allowed in the azp / appid claim.
ENTRA_ALLOWED_AZP=

# Single local user used only when AUTH_MODE=dev (impossible in production).
DEV_USER_SUBJECT=local-dev-user
DEV_USER_EMAIL=dev@localhost
DEV_USER_DISPLAY_NAME=Local Dev User
