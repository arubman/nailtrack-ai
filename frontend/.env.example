# dev: no bearer token, matching backend AUTH_MODE=dev.
# entra: MSAL sign-in against Entra External ID.
VITE_AUTH_MODE=dev
VITE_API_BASE_URL=http://127.0.0.1:8000

# Used only when VITE_AUTH_MODE=entra.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://YOUR_SUBDOMAIN.ciamlogin.com/YOUR_TENANT_ID
VITE_API_SCOPE=api://YOUR_API_CLIENT_ID/access_as_user
